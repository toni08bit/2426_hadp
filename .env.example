# Kopieren Sie diese Datei nach .env und tragen Sie Ihre Werte ein.
# Die Oberfläche ändert Host, Token und Intervall nicht — nur den Drucker.
# Primäre Konfiguration: config.yml (siehe config.example.yml).

HOST_URL=https://example.invalid
POLL_INTERVAL_SECONDS=5
BEARER_TOKEN=replace-with-your-token

# Optionaler Standarddrucker (CUPS-Druckername). Kann auch in der UI gewählt werden.
PRINTER=

# Zuständige Einheiten (Komma-getrennt) und Druckfilter — siehe config.example.yml
# RESPONSIBLE_UNITS=EIMSB-HLF-1,EIMSB-LF-2
# PRINT_FILTER=only_responsible

# forest-dark oder forest-light
THEME=forest-dark
